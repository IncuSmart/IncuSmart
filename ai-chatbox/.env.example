AI_CHATBOX_APP_NAME=IncuSmart AI Chatbox
AI_CHATBOX_ENV=production
AI_CHATBOX_ANSWER_LANGUAGE=vi

AI_CHATBOX_API_HOST=0.0.0.0
AI_CHATBOX_API_PORT=8001
AI_CHATBOX_CORS_ORIGINS=*
AI_CHATBOX_KNOWLEDGE_ENABLED=true
AI_CHATBOX_MAX_RAG_CHUNKS=4

AI_CHATBOX_POSTGRES_DSN=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
AI_CHATBOX_DEFAULT_EGG_TYPE=chicken
AI_CHATBOX_DEFAULT_TEMPLATE_NAME=default

AI_CHATBOX_RAG_PROVIDER=bigquery
AI_CHATBOX_LLM_PROVIDER=gemini
AI_CHATBOX_LLM_API_KEY=PUT_GEMINI_API_KEY_HERE
AI_CHATBOX_LLM_MODEL=gemini-2.5-flash
AI_CHATBOX_LLM_EMBEDDING_MODEL=gemini-embedding-001
AI_CHATBOX_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_CHATBOX_LLM_TIMEOUT_SECONDS=60
AI_CHATBOX_LLM_MAX_RETRIES=3
AI_CHATBOX_LLM_RETRY_BACKOFF_SECONDS=1

AI_CHATBOX_BIGQUERY_ML_ENABLED=true
AI_CHATBOX_BIGQUERY_PROJECT_ID=gen-lang-client-0799611217
AI_CHATBOX_BIGQUERY_CREDENTIALS_PATH=C:\inetpub\incusmart-ai\secrets\service-account.json
AI_CHATBOX_BIGQUERY_DATASET=incusmart_ml
AI_CHATBOX_BIGQUERY_LOCATION=asia-southeast1
AI_CHATBOX_BIGQUERY_TRAINING_TABLE=hatching_success_training
AI_CHATBOX_BIGQUERY_MODEL=hatching_success_model
AI_CHATBOX_BIGQUERY_PREDICTION_MAXIMUM_BYTES_BILLED=20971520
AI_CHATBOX_BIGQUERY_QUERY_TIMEOUT_SECONDS=30
AI_CHATBOX_BIGQUERY_RAG_EMBEDDINGS_TABLE=rag_embeddings
AI_CHATBOX_BIGQUERY_RAG_MAXIMUM_BYTES_BILLED=50000000

AI_CHATBOX_ENABLE_DEBUG_ENDPOINTS=false
